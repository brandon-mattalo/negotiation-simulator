# Database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# JWT Secret - generate a secure random string
JWT_SECRET=your-super-secret-jwt-key-here

# Claude API Key - get from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-...

# Environment
NODE_ENV=production
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-url.vercel.app

# ElevenLabs voice mode - get key at https://elevenlabs.io
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Encryption key for recoverable student passwords (32 bytes hex)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# Reviewer one-click login (/reviewer page). Passwords stay server-side and are
# never sent to the browser. Usernames are optional and default to the seeded
# reviewer-prof / reviewer-student accounts.
REVIEWER_PROF_PASSWORD=
REVIEWER_STUDENT_PASSWORD=
# REVIEWER_PROF_USERNAME=reviewer-prof
# REVIEWER_STUDENT_USERNAME=reviewer-student

# Emergency off switch for the /reviewer login page. Defaults to enabled;
# set to "false" in Railway to instantly disable it without a code change.
# REVIEWER_ACCOUNTS_ENABLED=false

# How often (in hours) reviewer-prof/reviewer-student's data resets back to
# the captured baseline (see `npm run reviewer:capture-baseline`). Checked
# lazily on each reviewer login, not on a real timer.
# REVIEWER_RESET_COOLDOWN_HOURS=1

# If reviewer-student's active session has been idle this many minutes, the
# next login attempt cancels it so a new visitor isn't blocked by someone
# else's abandoned session.
# REVIEWER_SESSION_IDLE_TIMEOUT_MINUTES=15

# The hourly reset defers itself while either reviewer account has done
# anything at all (not just sent a negotiation message - browsing, viewing a
# transcript, editing a config all count) within this many minutes, so e.g.
# hopping from the student account into the professor account to review a
# transcript doesn't get wiped out mid-review.
# REVIEWER_ACTIVITY_QUIET_MINUTES=5

# Caps on reviewer-student's usage, to bound worst-case Claude/ElevenLabs
# spend from this one public, passwordless-feeling account.
# REVIEWER_STUDENT_MAX_SESSIONS_PER_HOUR=10
# REVIEWER_STUDENT_MAX_MESSAGES_PER_SESSION=20
