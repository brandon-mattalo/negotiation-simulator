generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  instructor
  student
}

enum BotStrategy {
  collaborative
  competitive
  analytical
  emotional
}

enum DifficultyLevel {
  easy
  medium
  hard
  expert
}

enum AssignmentType {
  practice
  exam
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash       String    @map("password_hash")
  encryptedPassword  String?   @map("encrypted_password")
  role               UserRole
  // Admins are instructors who can also create/deactivate other instructor
  // accounts - not a separate role, just an extra capability on top of it.
  isAdmin       Boolean   @default(false) @map("is_admin")
  // Deactivated accounts can no longer log in, but their data (configs,
  // students' history, etc.) is left intact - not a destructive delete.
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  configurations Configuration[]
  sessions       Session[]       @relation("StudentSessions")
  assignmentMemberships AssignmentStudent[] @relation("AssignmentMemberships")
  instructorAssignments Assignment[] @relation("InstructorAssignments")
  enrolledStudents  Enrollment[] @relation("InstructorEnrollments")
  enrollment        Enrollment?  @relation("StudentEnrollment")
  classes           Class[]      @relation("InstructorClasses")

  @@map("users")
}

model Configuration {
  id                 String         @id @default(uuid())
  instructorId       String         @map("instructor_id")
  name               String
  scenario           String
  studentGoals       Json           @map("student_goals")
  botGoals           Json           @map("bot_goals")
  studentConstraints Json           @map("student_constraints")
  botConstraints     Json           @map("bot_constraints")
  botOpeningOffer    Json           @default("[]") @map("bot_opening_offer")
  rubric             Json           @default("[]") @map("rubric")
  botStrategy        BotStrategy    @map("bot_strategy")
  temperament        Int
  difficulty         DifficultyLevel
  timeLimit          Int            @map("time_limit")
  personality        Json
  isActive           Boolean        @default(false) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  instructor      User           @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sessions        Session[]
  assignments     Assignment[]

  @@map("configurations")
}

model Session {
  id              String    @id @default(uuid())
  studentId       String    @map("student_id")
  configurationId String    @map("configuration_id")
  assignmentId    String?   @map("assignment_id")
  // Only ever populated for reviewer-student's sessions (an IP-based proxy
  // for "which anonymous visitor," since that one account is shared by many
  // strangers over time). Always null for every real student session.
  ipAddress       String?   @map("ip_address")
  messages        Json
  startTime       DateTime  @default(now()) @map("start_time")
  endTime         DateTime? @map("end_time")
  timeRemaining   Int?      @map("time_remaining")
  isActive        Boolean   @default(true) @map("is_active")
  outcome         Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  student         User          @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  configuration   Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  assignment      Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model Template {
  id            String   @id @default(uuid())
  name          String
  description   String
  configuration Json
  isDefault     Boolean  @default(true) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model Assignment {
  id              String         @id @default(uuid())
  instructorId    String         @map("instructor_id")
  configurationId String         @map("configuration_id")
  name            String
  description     String
  assignmentType  AssignmentType @map("assignment_type")
  theme           String?
  availableFrom   DateTime       @map("available_from")
  availableUntil  DateTime       @map("available_until")
  deadline        DateTime
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  instructor      User                @relation("InstructorAssignments", fields: [instructorId], references: [id], onDelete: Cascade)
  configuration   Configuration       @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  students        AssignmentStudent[]
  sessions        Session[]

  @@map("assignments")
}

// One row per student assigned to an Assignment - a true many-to-many, so a
// single assignment (its config/name/schedule) can be shared by a group of
// students while each student's own progress is still tracked individually
// (via Session, which already carries both studentId and assignmentId).
model AssignmentStudent {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  studentId    String   @map("student_id")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("AssignmentMemberships", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_students")
}

// Tracks the hourly self-reset of the public reviewer-prof/reviewer-student
// demo accounts. Single-row table; touches nothing on User or any other
// existing model.
model ReviewerResetState {
  id              String    @id @default("singleton")
  lastResetAt     DateTime? @map("last_reset_at")
  baselineConfigs Json?     @map("baseline_configs")
  // Touched on every authenticated request from reviewer-prof or
  // reviewer-student (not just negotiation messages), so a reset can defer
  // itself while someone's browsing/reviewing, not only mid-negotiation.
  lastActivityAt  DateTime? @map("last_activity_at")

  @@map("reviewer_reset_state")
}

model Enrollment {
  id            String   @id @default(uuid())
  instructorId  String   @map("instructor_id")
  studentId     String   @unique @map("student_id")
  // null = Unassigned. Archiving a student (or archiving/deleting their class)
  // always clears this back to null - a student's class membership never
  // survives being archived, and unarchiving never restores it either.
  classId       String?  @map("class_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  instructor    User     @relation("InstructorEnrollments", fields: [instructorId], references: [id], onDelete: Cascade)
  student       User     @relation("StudentEnrollment", fields: [studentId], references: [id], onDelete: Cascade)
  class         Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@map("enrollments")
}

model Class {
  id            String   @id @default(uuid())
  instructorId  String   @map("instructor_id")
  name          String
  isArchived    Boolean  @default(false) @map("is_archived")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  instructor    User         @relation("InstructorClasses", fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]

  @@index([instructorId])
  @@map("classes")
}
